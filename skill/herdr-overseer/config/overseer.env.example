# herdr-overseer configuration. Copy to overseer.env (gitignored) and edit.
# Read by launch-worker.sh (bash `source`) and watch.py (simple KEY=value parser):
# keep every line as KEY=value or KEY="value", no command substitution.

# Lanes in rotation order. `--lane auto` takes them in strict round-robin, skipping lanes listed in
# state/lanes-paused. Lane names: A-Z, 0-9, _.
LANES="CLAUDE_A CLAUDE_B AGY OPENCODE"

# Per lane:
#   LANE_<name>_TYPE     claude | agy | opencode
#   LANE_<name>_CCS      claude lanes: ccs account/profile whose env (CLAUDE_CONFIG_DIR) the worker gets.
#                        Empty = the default `claude` login.
#   LANE_<name>_ACCOUNT  value of the worker's `agent.account` label (shown by Herdr mods that read it)
LANE_CLAUDE_A_TYPE=claude
LANE_CLAUDE_A_CCS=work
LANE_CLAUDE_A_ACCOUNT=work

LANE_CLAUDE_B_TYPE=claude
LANE_CLAUDE_B_CCS=personal
LANE_CLAUDE_B_ACCOUNT=personal

LANE_AGY_TYPE=agy
LANE_AGY_ACCOUNT=agy

LANE_OPENCODE_TYPE=opencode
LANE_OPENCODE_ACCOUNT=opencode

# Fixed models per lane type (the launcher rejects --model/--effort so every worker follows policy).
CLAUDE_MODEL="claude-sonnet-5-5"
CLAUDE_EFFORT="high"
AGY_MODEL="gemini-3.8-flash-high"
OPENCODE_MODEL="opencode-go/kimi-k3.1-pro"

# Caps on live workers.
MAX_PER_LANE=5
MAX_TOTAL=10

# agy workers that may write run with --dangerously-skip-permissions (their worktree is the only
# boundary). Set to 0 to use --mode accept-edits instead, if your agy account offers it.
AGY_SKIP_PERMISSIONS=1

# make-worktree.sh: for .env* files listed in a repo's worktree-include list, copy only lines whose
# variable name matches this regex (e.g. public client keys). Empty = never copy .env files.
WORKTREE_PUBLIC_ENV_RE="^(EXPO_PUBLIC_|NEXT_PUBLIC_|VITE_)"
