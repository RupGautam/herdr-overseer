# herdr-overseer configuration. Copy to overseer.env (gitignored) and edit, or let an LLM write it
# for you from SETUP.md. Sourced by bash (launch-worker.sh, make-worktree.sh). The Python scripts
# read only the plain KEY=value lines (LANES, LANE_*_MODEL, MAX_*, COORDINATOR_AGENTS).
#
# The launcher knows no agent CLI. Every lane is described here with the same template; copy-ready
# definitions for several CLIs are in config/lanes.examples.

# Lanes in rotation order. `--lane auto` takes them in strict round-robin, skipping lanes listed in
# state/lanes-paused. Names: A-Z 0-9 _.
LANES="A B"

# ---- Lane template (all fields of one lane share the prefix LANE_<name>_) ------------------------
#  CMD=(...)          required  base command that starts an interactive agent session in the cwd
#  RESUME_CMD=(...)   optional  command that continues the most recent session in the cwd
#                               (without it, --resume is refused for this lane)
#  RW_ARGS=(...)      optional  args added for write-capable workers (permission mode, sandbox, ...)
#  RO_ARGS=(...)      optional  args added for --read-only workers (plan mode, read-only sandbox, ...)
#  RO_ENV=(K=V ...)   optional  env for --read-only workers; with RO_ARGS unset too, the lane can't do read-only
#  RW_ENV=(K=V ...)   optional  env for write-capable workers
#  STATIC_ENV=(K=V)   optional  env for every worker of the lane (shown in --dry-run: no secrets here)
#  ENV_CMD="..."      optional  shell command printing `export KEY='value'` lines, e.g. an account switcher
#                               (values are injected but never printed)
#  TASK_FLAG=(...)    optional  flag(s) placed before the task text; empty = task is the last positional arg
#  ADD_DIR="..."      optional  flag for extra readable dirs: "--add-dir" (separate value) or "--add-dir="
#                               (joined); empty = lane does not support --add-dir
#  ACCOUNT="..."      optional  value of the worker's agent.account label (default: lane name)
#  MODEL="..."        optional  the model the lane must use; watch.py flags workers whose --model/-m differs
# Final argv: [RESUME_CMD | CMD] + [RO_ARGS | RW_ARGS] + add-dir args + TASK_FLAG + "<task>"
# --------------------------------------------------------------------------------------------------

# Example lane: a generic CLI agent. Replace with real definitions (see config/lanes.examples).
LANE_A_CMD=(my-agent --model some-model)
LANE_A_RESUME_CMD=(my-agent --model some-model --continue)
LANE_A_RO_ARGS=(--mode plan)
LANE_A_RW_ARGS=(--mode auto-edit)
LANE_A_ADD_DIR="--add-dir"
LANE_A_ACCOUNT="account-a"
LANE_A_MODEL="some-model"

LANE_B_CMD=(other-agent)
LANE_B_ENV_CMD="other-agent-accounts env second-account"
LANE_B_TASK_FLAG=(--prompt)
LANE_B_ACCOUNT="account-b"

# ---- Routing: which lane a new worker goes to (`--lane auto`) -----------------------------------
# Roles the coordinator may give workers (--role). Name them after the kinds of work you hand out.
ROLES="impl review probe"
# Pool per role: ROUTE_<role>="LANE ..."; roles without one use ROUTE_DEFAULT, else all of LANES.
# Within a pool the launcher rotates in strict round-robin (one counter per pool), skipping paused lanes.
# With none of these set, every role rotates across LANES.
#   ROUTE_impl="A B"          # implementation alternates between two accounts
#   ROUTE_review="B"          # reviews always go to B
#   ROUTE_DEFAULT="A B"
# Custom router: a shell command that prints the lane to use (it replaces the round-robin; the pool and
# pause rules still apply). It gets OVERSEER_CANDIDATES (eligible lanes), OVERSEER_ROUTE_ROLE, OVERSEER_NAME,
# OVERSEER_TASK, OVERSEER_READ_ONLY and OVERSEER_STATE_DIR. Examples: examples/router/.
ROUTER_CMD=""

# Caps on live workers.
MAX_PER_LANE=5
MAX_TOTAL=10

# hc agent names that can be a coordinator (handoff guard). hc reports e.g. claude-code, codex,
# opencode, antigravity. Space-separated.
COORDINATOR_AGENTS="claude-code"

# make-worktree.sh: for .env* files listed in a repo's worktree-include list, copy only lines whose
# variable name matches this regex (e.g. public client keys). Empty = never copy .env files.
WORKTREE_PUBLIC_ENV_RE="^(EXPO_PUBLIC_|NEXT_PUBLIC_|VITE_)"

# make-worktree.sh: commands run after a worktree is created, separated by ";". Each is called as
# <cmd> <main repo> <worktree> <worktree root>; e.g. to pre-trust the worktree in an agent CLI.
# Examples: examples/hooks/.
WORKTREE_POST_CREATE=""
